JWT_SECRET="replace-with-a-long-random-access-secret"
REFRESH_TOKEN_SECRET="replace-with-a-long-random-refresh-secret"
GMAIL_USER="you@example.com"
GMAIL_APP_PASSWORD="your-google-app-password"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only Cloudinary credentials. Never prefix the secret with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_SIGNATURE_FOLDER="email-signatures"

# Optional fallback when a signature image has not been uploaded to Cloudinary.
NEXT_PUBLIC_SIGNATURE_ASSET_BASE_URL="https://your-production-site.example.com"
